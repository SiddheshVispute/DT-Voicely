# =============================================================================
# Voicely Environment Configuration
# =============================================================================

# Backend Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# Frontend API URL
VITE_API_URL=http://localhost:3000

